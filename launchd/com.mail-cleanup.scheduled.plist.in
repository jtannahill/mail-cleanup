<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mail-cleanup.scheduled</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>--env</string>
        <string>MAIL_CLEANUP_ARGS=--all --quiet</string>
        <string>-a</string>
        <string>Mail Cleanup</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>@HOUR@</integer>
        <key>Minute</key>
        <integer>@MINUTE@</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/mail-cleanup-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/mail-cleanup-stderr.log</string>
</dict>
</plist>

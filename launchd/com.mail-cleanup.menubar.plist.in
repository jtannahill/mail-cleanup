<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mail-cleanup.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PREFIX@/.venv/bin/python3</string>
        <string>@PREFIX@/mail-cleanup-menubar.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/mail-cleanup-menubar-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/mail-cleanup-menubar-stderr.log</string>
</dict>
</plist>
